#!/sbin/openrc-run
# @DESC@
# Generated by amneziavpn-universal.

name="@NAME@"
description="@DESC@"
command="@BIN@"
command_args="@ARGS@"
pidfile="/run/@NAME@.pid"
command_user="root:root"

# Prefer supervise-daemon: it gives us systemd-like "Restart=always".
if command -v supervise-daemon >/dev/null 2>&1; then
    supervisor="supervise-daemon"
    respawn_delay=1
    respawn_max=0
else
    command_background=true
fi

depend() {
    @OPENRC_DEPS@
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /run
    case "@NAME@" in
        amneziavpn)
            checkpath --directory --owner root:root --mode 0755 "@LOGDIR@"
            ;;
    esac
}

stop_post() {
    case "@NAME@" in
        amneziavpn)
            # A hard kill can leave the AmneziaVPN iptables chains behind.
            if command -v iptables >/dev/null 2>&1; then
                iptables -S 2>/dev/null \
                    | sed -n 's/^-N \(amnvpn[^ ]*\)$/\1/p' \
                    | while read -r chain; do
                        iptables -F "$chain" 2>/dev/null
                        iptables -X "$chain" 2>/dev/null
                    done
            fi
            ;;
    esac
}
